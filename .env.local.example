# Privy App ID - get it from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Backend API URL
NEXT_PUBLIC_API_BASE_URL=https://api.evolute.app

# Optional: allowed origins for Next.js dev server internal assets (_next/*)
# Comma-separated hostnames/IPs, e.g. 192.168.31.94,localhost
# NEXT_ALLOWED_DEV_ORIGINS=192.168.31.94,localhost

# CCTP environment switch (mainnet | testnet)
NEXT_PUBLIC_CCTP_ENV=testnet

# Optional explicit source chain override (base | base-sepolia)
# NEXT_PUBLIC_CCTP_SOURCE_CHAIN=base-sepolia

# CCTP mainnet config
NEXT_PUBLIC_CCTP_USDC_ADDRESS_MAINNET=your-base-mainnet-usdc-address
NEXT_PUBLIC_CCTP_TOKEN_MESSENGER_V2_ADDRESS_MAINNET=your-base-mainnet-token-messenger-v2
NEXT_PUBLIC_CCTP_FORWARDING_HOOK_DATA_MAINNET=0x

# CCTP testnet config
NEXT_PUBLIC_CCTP_USDC_ADDRESS_TESTNET=your-base-sepolia-usdc-address
NEXT_PUBLIC_CCTP_TOKEN_MESSENGER_V2_ADDRESS_TESTNET=your-base-sepolia-token-messenger-v2
NEXT_PUBLIC_CCTP_FORWARDING_HOOK_DATA_TESTNET=0x
